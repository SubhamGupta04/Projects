
module fifo #(
    parameter WIDTH = 16,
    parameter DEPTH = 16,
    parameter SIZE  = (DEPTH <= 1) ? 1 : $clog2(DEPTH)
)(
    input  logic clk,
    input  logic rst,

    input  logic wr_en,
    input  logic rd_en,
    input  logic [WIDTH-1:0] data_in,

    output logic [WIDTH-1:0] data_out,
    output logic overflow,
    output logic underflow,
    output logic full,
    output logic almost_full,
    output logic almost_empty,
    output logic empty,
    output logic wr_ack
);

    logic [SIZE-1:0] wr_ptr;
    logic [SIZE-1:0] rd_ptr;

    logic [SIZE:0] count;

    logic [WIDTH-1:0] mem [0:DEPTH-1];

    // WRITE
    always_ff @(posedge clk or negedge rst) begin

        if (!rst) begin

            wr_ptr   <= 0;
            overflow <= 0;
            wr_ack   <= 0;

            for (int i = 0; i < DEPTH; i++) begin
                mem[i] <= 0;
            end

        end
        else begin

            overflow <= 0;
            wr_ack   <= 0;

            if (wr_en && !full) begin

                mem[wr_ptr] <= data_in;

                if (wr_ptr == DEPTH-1)
                    wr_ptr <= 0;
                else
                    wr_ptr <= wr_ptr + 1;

                wr_ack <= 1;

            end
            else if (wr_en && full) begin

                overflow <= 1;

            end

        end

    end


    //  READ 
    always_ff @(posedge clk or negedge rst) begin

        if (!rst) begin

            rd_ptr    <= 0;
            underflow <= 0;
            data_out <= 0;

        end
        else begin

            underflow <= 0;

            if (rd_en && !empty) begin

                data_out <= mem[rd_ptr];

                if (rd_ptr == DEPTH-1)
                    rd_ptr <= 0;
                else
                    rd_ptr <= rd_ptr + 1;

            end
            else if (rd_en && empty) begin

                underflow <= 1;

            end

        end

    end


    // COUNT 
    always_ff @(posedge clk or negedge rst) begin

        if (!rst) begin

            count <= 0;

        end
        else begin

            case ({wr_en && !full, rd_en && !empty})

                2'b10:
                    count <= count + 1;

                2'b01:
                    count <= count - 1;

                2'b11:
                    count <= count;

                default:
                    count <= count;

            endcase

        end

    end


    // STATUS 

    assign empty        = (count == 0);
    assign full         = (count == DEPTH);
    assign almost_empty = (count == 1);
    assign almost_full  = (count == DEPTH-1);

endmodule
